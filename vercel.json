{
  "installCommand": "echo 'Zero build dependencies: nothing to install'",
  "buildCommand": "node scripts/build.mjs && node scripts/build-site.mjs",
  "outputDirectory": "public",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
